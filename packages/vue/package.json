{
  "name": "@keystone-dashboard-layout/vue",
  "version": "1.0.0",
  "type": "module",
  "description": "Vue 3 Responsive & Dynamic Grid / Dashboard layout with drag, drop and resizable actions.",
  "author": "Geirr Winnem <geirr@winnem.tech>",
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/gwinnem"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "vue-component-library",
    "vue-plugin",
    "composition-api",
    "typescript",
    "vite",
    "grid",
    "grid-layout",
    "responsive-grid-layout",
    "dynamic-grid-layout",
    "dashboard",
    "dashboard-layout",
    "dynamic-dashboard",
    "drag",
    "drop",
    "drag-and-drop",
    "draggable",
    "resizable",
    "resize",
    "responsive",
    "multi-select",
    "group-move",
    "group-resize",
    "snap-to-grid",
    "alignment-guides",
    "cross-grid-drag",
    "outside-drop",
    "bin-packing",
    "auto-height",
    "compaction",
    "undo-redo",
    "layout-persistence",
    "layout-presets",
    "svg-export",
    "keyboard-accessibility",
    "a11y",
    "aria"
  ],
  "main": "dist/keystone-dashboard-layout-vue.umd.js",
  "module": "dist/keystone-dashboard-layout-vue.es.js",
  "types": "./dist/types/components/index.d.ts",
  "files": [
    "dist/*",
    "LICENSE",
    "NOTICE.md",
    "SUPPORT.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/keystone-dashboard-layout-vue.es.js",
      "require": "./dist/keystone-dashboard-layout-vue.umd.js"
    },
    "./style.css": "./dist/vue.css"
  },
  "homepage": "https://github.com/gwinnem/keystone-dashboard-layout/tree/main/packages/vue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwinnem/keystone-dashboard-layout.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/gwinnem/keystone-dashboard-layout/issues"
  },
  "scripts": {
    "dev": "vite",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "coverage": "vitest run --coverage",
    "build:all": "vite build && npm pack",
    "build": "vite build",
    "package": "node scripts/generate-package.js",
    "analyze": "vite build --config vite.analyze.config.js",
    "build:types": "vite build",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "check:package-install": "node scripts/check-package-install.js",
    "test:mutation": "cd ../.. && stryker run packages/vue/stryker.conf.json",
    "test:mutation:debug": "cd ../.. && stryker run packages/vue/stryker.conf.json --fileLogLevel trace --logLevel debug",
    "typecheck": "vue-tsc --project tsconfig.json --noEmit",
    "lint": "eslint --color",
    "lint:fix": "eslint --fix --color",
    "lint:style": "npx stylelint src/**/*.{scss,vue} --no-fix --color",
    "lint:style-fix": "npx stylelint src/**/*.{scss,vue} --fix --color",
    "lint:markup": "vue-tsc -noEmit",
    "format": "prettier --write \"src/**/*\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:visual": "cross-env RUN_VISUAL_REGRESSION=1 playwright test visual-regression",
    "test:e2e:visual:update": "cross-env RUN_VISUAL_REGRESSION=1 playwright test visual-regression --update-snapshots"
  },
  "dependencies": {
    "@keystone-dashboard-layout/core": "workspace:*"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^1.1.11",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.11",
    "@vue/theme": "^2.3.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "path": "^0.12.7",
    "postcss": "^8.5.3",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.87.0",
    "scss": "^0.2.4",
    "semantic-release": "^25.0.8",
    "semantic-release-monorepo": "^8.0.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10",
    "vue": "^3.2.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-multiselect": "^3.2.0",
    "vue-tsc": "^3.3.7"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
