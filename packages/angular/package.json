{
  "name": "@keystone-dashboard-layout/angular",
  "version": "0.1.0",
  "description": "Angular port of the responsive & dynamic grid / dashboard layout with drag, drop and resizable actions.",
  "author": "Geirr Winnem <geirr@winnem.tech>",
  "license": "MIT",
  "main": "dist/keystone-dashboard-layout-angular/index.js",
  "types": "./dist/keystone-dashboard-layout-angular/index.d.ts",
  "files": ["dist/keystone-dashboard-layout-angular/*", "LICENSE", "NOTICE.md", "SUPPORT.md"],
  "exports": {
    "./style.css": "./dist/keystone-dashboard-layout-angular/styles/index.css"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwinnem/keystone-dashboard-layout.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/gwinnem/keystone-dashboard-layout/issues"
  },
  "scripts": {
    "build:styles": "sass src/styles/index.scss src/styles/index.css --no-source-map --style=compressed",
    "build": "pnpm run build:styles && ng-packagr -p ng-package.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:mutation": "stryker run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint:style": "stylelint src/styles/**/*.scss --no-fix --color",
    "lint:style-fix": "stylelint src/styles/**/*.scss --fix --color",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "check:package-install": "node scripts/check-package-install.js"
  },
  "_comment_scripts": "dev/lint/lint:fix/test:e2e intentionally still omitted. `test`/`test:coverage` now run through Jest + jest-preset-angular (mature, widely used for Angular unit/component testing, and — unlike the Vitest paths tried before it — actually available for this package's Angular ^19.0.0 target: Angular's own first-party Vitest builder, @angular/build:unit-test, only exists from v20 (experimental) / v21 (stable), and the third-party @analogjs/vite-plugin-angular route hit a genuinely unresolved upstream ecosystem bug, analogjs/analog#1502 / angular/angular-cli#31732). Karma (angular.json's own project-scoped `test` architect target + karma.conf.js, both still present) is kept for a possible future full-app browser-flow e2e layer, per the same reasoning as before — not used for unit/component tests at all now. turbo skips tasks a package doesn't define, so CI stays green in the meantime.",
  "dependencies": {
    "@keystone-dashboard-layout/core": "workspace:*",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular-devkit/build-angular": "^19.0.0",
    "@anolilab/semantic-release-pnpm": "^1.1.11",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/jasmine": "^5.1.0",
    "@types/jest": "^29.5.0",
    "jasmine-core": "^5.4.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.1.0",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^19.0.0",
    "puppeteer": "^24.0.0",
    "rxjs": "^7.8.0",
    "sass": "^1.87.0",
    "semantic-release": "^25.0.8",
    "semantic-release-monorepo": "^8.0.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-node": "^10.9.0",
    "typescript": "~5.7.0",
    "zone.js": "^0.15.0"
  },
  "peerDependencies": {
    "@angular/common": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "rxjs": "^7.8.0"
  },
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || >=22.0.0"
  }
}
