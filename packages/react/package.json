{
  "name": "@keystone-dashboard-layout/react",
  "version": "1.0.0",
  "type": "module",
  "description": "React port of the responsive & dynamic grid / dashboard layout with drag, drop and resizable actions.",
  "author": "Geirr Winnem <geirr@winnem.tech>",
  "license": "MIT",
  "main": "dist/keystone-dashboard-layout-react.umd.js",
  "module": "dist/keystone-dashboard-layout-react.es.js",
  "types": "./dist/types/index.d.ts",
  "files": ["dist/*", "LICENSE", "NOTICE.md", "SUPPORT.md"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/keystone-dashboard-layout-react.es.js",
      "require": "./dist/keystone-dashboard-layout-react.umd.js"
    },
    "./style.css": "./dist/react.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwinnem/keystone-dashboard-layout.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/gwinnem/keystone-dashboard-layout/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint --color",
    "lint:fix": "eslint --fix --color",
    "lint:style": "stylelint src/**/*.scss --no-fix --color",
    "lint:style-fix": "stylelint src/**/*.scss --fix --color",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "check:package-install": "node scripts/check-package-install.js"
  },
  "dependencies": {
    "@keystone-dashboard-layout/core": "workspace:*"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^1.1.11",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.87.0",
    "semantic-release": "^25.0.8",
    "semantic-release-monorepo": "^8.0.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
