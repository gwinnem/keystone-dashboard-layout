{
  "name": "keystone-dashboard-layout-react",
  "version": "1.0.0",
  "type": "module",
  "description": "React port of the responsive & dynamic grid / dashboard layout with drag, drop and resizable actions.",
  "author": "Geirr Winnem <geirr@winnem.tech>",
  "license": "MIT",
  "homepage": "https://kdl.winnem.tech/react/",
  "keywords": [
    "react",
    "react-component",
    "react-component-library",
    "react-hooks",
    "typescript",
    "vite",
    "grid",
    "grid-layout",
    "responsive-grid-layout",
    "dynamic-grid-layout",
    "dashboard",
    "dashboard-layout",
    "dynamic-dashboard",
    "drag",
    "drop",
    "drag-and-drop",
    "draggable",
    "resizable",
    "resize",
    "responsive",
    "multi-select",
    "group-move",
    "group-resize",
    "snap-to-grid",
    "alignment-guides",
    "cross-grid-drag",
    "outside-drop",
    "bin-packing",
    "auto-height",
    "compaction",
    "undo-redo",
    "layout-persistence",
    "layout-presets",
    "svg-export",
    "keyboard-accessibility",
    "a11y",
    "aria"
  ],
  "main": "dist/keystone-dashboard-layout-react.umd.js",
  "module": "dist/keystone-dashboard-layout-react.es.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/*",
    "LICENSE",
    "NOTICE.md",
    "SUPPORT.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/keystone-dashboard-layout-react.es.js",
      "require": "./dist/keystone-dashboard-layout-react.umd.js"
    },
    "./style.css": "./dist/keystone-dashboard-layout-react.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwinnem/keystone-dashboard-layout.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/gwinnem/keystone-dashboard-layout/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint --color",
    "lint:fix": "eslint --fix --color",
    "lint:style": "stylelint src/**/*.scss --no-fix --color",
    "lint:style-fix": "stylelint src/**/*.scss --fix --color",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "check:package-install": "node scripts/check-package-install.js",
    "changeset": "node ../../scripts/changeset.mjs"
  },
  "dependencies": {
    "keystone-dashboard-layout-core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.87.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
