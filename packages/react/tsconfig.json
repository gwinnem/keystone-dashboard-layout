{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "declarationDir": "dist/types",
    "paths": {
      "@/*": ["./src/*"],
      "@/core/*": ["../core/src/*"]
    },
    // Widened to this package's own *parent* directory (not just ".",
    // this package's own root) because `@/core/*` now reaches into the
    // sibling `../core/src` package — a genuine cross-package boundary,
    // the same reason the Vue package's own tsconfig.json widens its
    // own `rootDir` to `".."` too (see that file's matching comment).
    // `tsconfig.build-types.json` (used by `vite-plugin-dts` for the
    // real declaration build) inherits this same value rather than
    // re-narrowing it back to `"src"` — confirmed via a real `pnpm
    // build` run reproducing a TS6059 cascade when it once did
    // re-narrow, the identical bug the Vue package's own tsconfig.json
    // documents finding and fixing the same way. `vite.config.ts`'s own
    // separate `entryRoot: 'src'` option on the `dts` plugin is what
    // actually controls the *output* path structure, independent of
    // this compiler-level `rootDir` (which only affects type-checking
    // and TS6059 enforcement) — so widening this doesn't shift where
    // declaration files land.
    "rootDir": "..",
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/__tests__/*", "**/*.spec.tsx", "**/*.spec.ts", "dist", "node_modules", "tests/*"]
}
