{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declarationDir": "dist/types",
    "paths": {
      "@/core/*": ["./src/*"]
    },
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "**/*.spec.ts", "dist", "node_modules"]
}
