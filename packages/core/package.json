{
  "name": "keystone-dashboard-layout-core",
  "version": "1.0.1",
  "type": "module",
  "description": "Framework-agnostic grid-layout algorithms (bin-packing, collision detection, compaction, responsive breakpoints, alignment guides) shared by the Vue, React, and Angular packages in this monorepo. Zero framework dependency — every function takes plain data in, returns plain data out.",
  "author": "Geirr Winnem <geirr@winnem.tech>",
  "license": "MIT",
  "sideEffects": false,
  "main": "dist/keystone-dashboard-layout-core.cjs.js",
  "module": "dist/keystone-dashboard-layout-core.es.js",
  "types": "./dist/types/index.d.ts",
  "files": ["dist/*", "LICENSE", "NOTICE.md", "SUPPORT.md"],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/keystone-dashboard-layout-core.es.js",
      "require": "./dist/keystone-dashboard-layout-core.cjs.js"
    },
    "./gridlayout/helpers/cross-grid-registry": {
      "types": "./dist/types/gridlayout/helpers/cross-grid-registry.d.ts",
      "import": "./dist/cross-grid-registry.es.js",
      "require": "./dist/cross-grid-registry.cjs.js"
    },
    "./gridlayout/interfaces/cross-grid.interfaces": {
      "types": "./dist/types/gridlayout/interfaces/cross-grid.interfaces.d.ts",
      "import": "./dist/cross-grid-interfaces.es.js",
      "require": "./dist/cross-grid-interfaces.cjs.js"
    }
  },
  "homepage": "https://kdl.winnem.tech/core/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwinnem/keystone-dashboard-layout.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gwinnem/keystone-dashboard-layout/issues"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint --color",
    "lint:fix": "eslint --fix --color",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
