---
// Custom landing page, per PLAN.md section 4.1 — not a Starlight page,
// a fully custom Astro page reusing the approved mockup
// (astro-docs/_design/mockup-landing.html) almost verbatim, wired to
// real routes instead of placeholder hrefs.
---
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KeystoneGrid — a draggable, resizable dashboard grid for Vue, React &amp; Angular</title>
  <script is:inline>
    // Runs before the body paints, so the correct theme is already
    // applied by the time anything is visible — doing this in the
    // bottom-of-page script instead would cause a visible flash of
    // the wrong theme on every load. Kept deliberately tiny and
    // dependency-free since it has to run this early.
    //
    // Also keeps localStorage['starlight-theme'] (the key Starlight's
    // own ThemeProvider reads — confirmed directly from its real
    // source in node_modules, not assumed) in sync with this site's own
    // 'kg-theme' key, so the docs pages genuinely inherit whatever was
    // chosen here instead of running their own separate, disconnected
    // preference. Starlight stores '' for auto and 'light'/'dark'
    // otherwise — matching its own storeTheme() exactly.
    (function () {
      var stored = localStorage.getItem('kg-theme');
      var theme = stored === 'light' || stored === 'dark' ? stored : 'auto';
      var resolved = theme === 'auto'
        ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : theme;
      document.documentElement.setAttribute('data-theme', resolved);
      document.documentElement.setAttribute('data-theme-pref', theme);
      localStorage.setItem('starlight-theme', theme === 'auto' ? '' : theme);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    @import '../styles/tokens.css';
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}

    /* Theme-aware semantic tokens — only the "content" sections below
       the hero (picker cards, spec grid) actually switch between
       light/dark; the nav/hero/footer stay permanently dark in both
       modes, matching the deliberate dark-navbar-regardless-of-theme
       pattern used across most marketing sites. Default (no
       data-theme attribute, or data-theme="light") matches the
       page's original, single fixed look exactly — nothing about the
       existing design changed, these variables just now sit between
       the raw --kg-* tokens and the rules that use them. */
    :root{
      --page-bg:var(--kg-paper);
      --page-text:var(--kg-text-hi-light);
      --page-text-lo:var(--kg-text-lo-light);
      --page-line:var(--kg-line-light);
      --card-bg:#ffffff;
      --card-bg-live:#FFFCF5;
      --card-status-bg:rgba(20,23,26,0.06);
      --spec-bg:var(--kg-paper-3);
    }
    [data-theme="dark"]{
      --page-bg:var(--kg-ink);
      --page-text:var(--kg-text-hi-dark);
      --page-text-lo:var(--kg-text-lo-dark);
      --page-line:var(--kg-line-dark);
      --card-bg:var(--kg-ink-2);
      --card-bg-live:var(--kg-ink-3);
      --card-status-bg:rgba(255,255,255,0.08);
      --spec-bg:var(--kg-ink-3);
    }

    body{
      font-family:var(--kg-font-body);
      background:var(--page-bg);
      color:var(--page-text);
      -webkit-font-smoothing:antialiased;
      transition:background-color .2s ease, color .2s ease;
    }
    a{color:inherit;text-decoration:none;}
    .wrap{max-width:1180px;margin:0 auto;padding:0 32px;}

    .nav{background:var(--kg-ink);border-bottom:1px solid var(--kg-line-dark);}
    .nav-inner{display:flex;align-items:center;justify-content:space-between;padding:18px 32px;max-width:1180px;margin:0 auto;}
    .brand{display:flex;align-items:center;gap:10px;}
    .brand-mark{width:22px;height:22px;flex-shrink:0;}
    .brand-name{font-family:var(--kg-font-display);font-weight:600;font-size:17px;color:var(--kg-text-hi-dark);letter-spacing:-0.01em;}
    .nav-links{display:flex;align-items:center;gap:28px;}
    .nav-link{font-size:14px;color:var(--kg-text-lo-dark);font-weight:500;transition:color .15s ease;}
    .nav-link:hover{color:var(--kg-text-hi-dark);}
    .nav-icons{display:flex;align-items:center;gap:18px;}
    .nav-icons a svg{width:20px;height:20px;display:block;}
    .nav-icons a{position:relative;}
    .nav-icon-tooltip{position:absolute;top:calc(100% + 10px);left:50%;transform:translate(-50%, -4px);background:var(--kg-ink-3);border:1px solid var(--kg-line-dark);border-radius:4px;color:var(--kg-text-hi-dark);font-family:var(--kg-font-body);font-size:11px;font-weight:500;padding:4px 8px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .15s ease, transform .15s ease;z-index:10;}
    .nav-icons a:hover .nav-icon-tooltip{opacity:1;transform:translate(-50%, 0);}
    .nav-cta{font-size:13px;font-family:var(--kg-font-mono);color:var(--kg-ink);background:var(--kg-blueprint);padding:8px 14px;border-radius:6px;font-weight:500;}

    .fw-select{position:relative;}
    .fw-select-trigger{display:flex;align-items:center;gap:6px;background:none;border:none;font-size:14px;color:var(--kg-text-lo-dark);font-weight:500;cursor:pointer;transition:color .15s ease;font-family:inherit;}
    .fw-select-trigger:hover{color:var(--kg-text-hi-dark);}
    .fw-select-trigger-icon{width:16px;height:16px;flex-shrink:0;}
    #theme-select .theme-icon-light,
    #theme-select .theme-icon-dark,
    #theme-select .theme-icon-auto{display:none;}
    #theme-select[data-current-theme="light"] .theme-icon-light{display:block;}
    #theme-select[data-current-theme="dark"] .theme-icon-dark{display:block;}
    #theme-select[data-current-theme="auto"] .theme-icon-auto{display:block;}
    .theme-select-option.is-current{color:var(--kg-amber);}
    .fw-select-chevron{width:11px;height:11px;flex-shrink:0;color:var(--kg-text-lo-dark);transition:transform .15s ease;}
    .fw-select.is-open .fw-select-chevron{transform:rotate(180deg);}
    .fw-select-menu{position:absolute;top:calc(100% + 14px);left:0;min-width:170px;background:var(--kg-ink-2);border:1px solid var(--kg-line-dark);border-radius:9px;box-shadow:0 12px 28px -8px rgba(0,0,0,0.5);padding:6px;z-index:20;opacity:0;transform:translateY(-6px);pointer-events:none;transition:opacity .18s ease, transform .18s ease;}
    .fw-select-menu.is-visible{opacity:1;transform:translateY(0);pointer-events:auto;}
    .fw-select-option{display:flex;align-items:center;gap:10px;width:100%;padding:8px 10px;border-radius:6px;font-family:var(--kg-font-body);font-size:13.5px;font-weight:500;color:var(--kg-text-hi-dark);background:none;border:none;cursor:pointer;text-align:left;}
    .fw-select-option:hover{background:rgba(255,255,255,0.06);}
    .fw-select-option svg{width:16px;height:16px;flex-shrink:0;}
    .fw-select-option-status{margin-left:auto;font-family:var(--kg-font-mono);font-size:10px;color:var(--kg-text-lo-dark);}
    .fw-select-option.is-current .fw-select-option-status{color:var(--kg-amber);}

    .hero{background:var(--kg-ink);background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,0.09) 1px, transparent 0);background-size:26px 26px;padding:88px 0 0;position:relative;overflow:hidden;}
    .hero-inner{max-width:1180px;margin:0 auto;padding:0 32px 96px;display:grid;grid-template-columns:1.02fr 0.98fr;gap:56px;align-items:center;}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;font-family:var(--kg-font-mono);font-size:12px;letter-spacing:0.06em;color:var(--kg-blueprint);border:1px solid var(--kg-blueprint-deep);background:rgba(79,184,201,0.08);padding:6px 12px;border-radius:100px;margin-bottom:24px;}
    .eyebrow-dot{width:6px;height:6px;border-radius:50%;background:var(--kg-amber);}
    h1.headline{font-family:var(--kg-font-display);font-weight:600;font-size:56px;line-height:1.04;letter-spacing:-0.02em;color:var(--kg-text-hi-dark);margin-bottom:22px;}
    h1.headline .accent{color:var(--kg-amber);}
    .hero-sub{font-size:17px;line-height:1.65;color:var(--kg-text-lo-dark);max-width:480px;margin-bottom:36px;}
    .hero-sub code{font-family:var(--kg-font-mono);font-size:15px;color:var(--kg-blueprint);background:rgba(79,184,201,0.1);padding:1px 6px;border-radius:4px;}
    .fw-inline{display:inline-flex;align-items:center;gap:4px;white-space:nowrap;}
    .fw-inline svg{width:14px;height:14px;flex-shrink:0;}
    .cta-row{display:flex;align-items:center;gap:14px;margin-bottom:44px;}
    .btn{font-family:var(--kg-font-body);font-weight:500;font-size:14px;padding:12px 22px;border-radius:7px;display:inline-flex;align-items:center;gap:8px;transition:transform .12s ease, background .15s ease, border-color .15s ease;}
    .btn:hover{transform:translateY(-1px);}
    .btn-primary{background:var(--kg-amber);color:#2B1B02;}
    .btn-primary:hover{background:#F5B857;}
    .btn-ghost{border:1px solid var(--kg-line-dark);color:var(--kg-text-hi-dark);}
    .btn-ghost:hover{border-color:rgba(255,255,255,0.28);background:rgba(255,255,255,0.03);}
    .hero-meta{display:flex;gap:28px;font-family:var(--kg-font-mono);font-size:12.5px;color:var(--kg-text-lo-dark);}
    .hero-meta strong{color:var(--kg-text-hi-dark);font-weight:500;}

    .stage{position:relative;height:460px;border-radius:14px;background:var(--kg-ink-2);border:1px solid var(--kg-line-dark);overflow:hidden;}
    .stage-grid{position:absolute;inset:0;background-image:linear-gradient(to right, var(--kg-line-dark) 1px, transparent 1px),linear-gradient(to bottom, var(--kg-line-dark) 1px, transparent 1px);background-size:44px 44px;opacity:0.7;}
    .g-item{position:absolute;border-radius:9px;display:flex;flex-direction:column;justify-content:flex-start;padding:12px 14px;}
    .g-item .label{font-family:var(--kg-font-mono);font-size:11px;font-weight:500;}
    .g-item .bars span{display:block;height:5px;border-radius:3px;margin-top:5px;}
    .mini-chart{width:100%;height:auto;margin-top:10px;flex-shrink:0;}
    .mini-table{margin-top:10px;display:flex;flex-direction:column;gap:5px;}
    .mini-table-row{display:flex;justify-content:space-between;font-family:var(--kg-font-mono);font-size:10px;color:rgba(255,255,255,0.5);padding-bottom:5px;border-bottom:1px solid rgba(255,255,255,0.08);}
    .mini-table-row span:last-child{color:rgba(255,255,255,0.82);}
    .g-1{top:24px;left:24px;width:150px;height:118px;background:var(--kg-ink-3);border:1px solid var(--kg-line-dark);}
    .g-1 .label{color:var(--kg-text-lo-dark);}
    .g-2{top:24px;left:190px;width:150px;height:118px;background:var(--kg-ink-3);border:1px solid var(--kg-line-dark);}
    .g-2 .label{color:var(--kg-text-lo-dark);}
    .g-3{top:24px;left:356px;width:112px;height:118px;background:var(--kg-ink-3);border:1px solid var(--kg-line-dark);}
    .g-3 .label{color:var(--kg-text-lo-dark);}
    .g-3 .bars span{background:rgba(255,255,255,0.10);}
    .g-3 .bars span:nth-child(1){width:70%;}
    .g-3 .bars span:nth-child(2){width:40%;}
    .g-4{top:158px;left:24px;width:150px;height:150px;background:var(--kg-ink-3);border:1px solid var(--kg-line-dark);}
    .g-4 .label{color:var(--kg-text-lo-dark);}
    .g-5{top:158px;left:190px;width:150px;height:98px;background:var(--kg-ink-3);border:1px solid var(--kg-line-dark);}
    .g-5 .label{color:var(--kg-text-lo-dark);}
    .g-5 .bars span{background:rgba(255,255,255,0.10);}
    .g-5 .bars span:nth-child(1){width:55%;}
    .g-5 .bars span:nth-child(2){width:75%;}
    .ghost{position:absolute;top:266px;left:190px;width:150px;height:98px;border:1.5px dashed rgba(242,169,59,0.45);border-radius:9px;background:rgba(242,169,59,0.04);}
    .g-dragged{top:342px;left:250px;width:150px;height:98px;background:var(--kg-paper);color:var(--kg-ink);transform:rotate(-3deg);box-shadow:0 22px 40px -12px rgba(0,0,0,0.55), 0 0 0 1.5px var(--kg-amber);z-index:5;}
    .g-dragged .label{color:var(--kg-amber-deep);}
    .g-dragged .bars span{background:rgba(20,23,26,0.14);}
    .g-dragged .bars span:nth-child(1){width:75%;}
    .g-dragged .bars span:nth-child(2){width:50%;}
    .coord-tag{position:absolute;top:294px;left:24px;font-family:var(--kg-font-mono);font-size:11px;color:var(--kg-amber);background:var(--kg-ink);border:1px solid var(--kg-amber-deep);padding:5px 9px;border-radius:6px;white-space:nowrap;display:flex;align-items:center;gap:6px;z-index:6;}
    .coord-tag svg{width:11px;height:11px;flex-shrink:0;}

    .section{padding:80px 0;}
    .section-head{margin-bottom:40px;max-width:640px;}
    .section-eyebrow{font-family:var(--kg-font-mono);font-size:12px;letter-spacing:0.08em;color:var(--kg-blueprint-deep);margin-bottom:12px;display:block;}
    h2.section-title{font-family:var(--kg-font-display);font-weight:600;font-size:30px;letter-spacing:-0.015em;margin-bottom:12px;color:var(--page-text);}
    .section-desc{font-size:15.5px;line-height:1.6;color:var(--page-text-lo);}

    .picker-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
    .picker-card{border:1px solid var(--page-line);border-radius:12px;padding:26px 24px;background:var(--card-bg);display:flex;flex-direction:column;gap:14px;position:relative;transition:background-color .2s ease, border-color .2s ease;}
    .picker-card.is-live{border:2px solid var(--kg-amber);background:var(--card-bg-live);}
    .picker-status{position:absolute;top:20px;right:20px;font-family:var(--kg-font-mono);font-size:10.5px;letter-spacing:0.03em;padding:4px 9px;border-radius:100px;}
    .status-live{background:rgba(242,169,59,0.16);color:var(--kg-amber-deep);}
    .status-soon{background:var(--card-status-bg);color:var(--page-text-lo);}
    .picker-icon{width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center;}
    .picker-icon svg{width:20px;height:20px;}
    .icon-vue{background:rgba(79,184,201,0.14);}
    .icon-react{background:rgba(97,218,251,0.14);}
    .icon-angular{background:rgba(221,0,49,0.09);}
    .picker-title{font-family:var(--kg-font-display);font-weight:600;font-size:18px;}
    .picker-desc{font-size:13.5px;line-height:1.55;color:var(--page-text-lo);}
    .picker-links{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:16px;}
    .picker-link{font-family:var(--kg-font-mono);font-size:12.5px;display:flex;align-items:center;gap:6px;}
    .link-live{color:var(--kg-amber-deep);}
    .link-soon{color:var(--page-text-lo);opacity:0.7;}
    .link-npm{color:var(--page-text-lo);}
    .link-npm:hover{color:var(--page-text);}
    .link-npm svg{width:34px;height:34px;flex-shrink:0;}

    .spec{background:var(--spec-bg);border-top:1px solid var(--page-line);border-bottom:1px solid var(--page-line);transition:background-color .2s ease;}
    .spec-grid{display:grid;grid-template-columns:repeat(4,1fr);}
    .spec-cell{padding:26px 24px;border-right:1px solid var(--page-line);border-bottom:1px solid var(--page-line);}
    .spec-cell:nth-child(4n){border-right:none;}
    .spec-icon{font-family:var(--kg-font-mono);font-size:12px;color:var(--kg-blueprint-deep);margin-bottom:12px;display:block;}
    .spec-title{font-family:var(--kg-font-display);font-weight:600;font-size:14.5px;margin-bottom:6px;}
    .spec-desc{font-size:12.8px;line-height:1.5;color:var(--page-text-lo);}

    .footer{background:var(--kg-ink);padding:44px 0;}
    .footer-inner{display:flex;align-items:center;justify-content:center;}
    .footer-brand{display:flex;align-items:center;gap:10px;}
    .footer-links{display:flex;gap:26px;font-size:13px;color:var(--kg-text-lo-dark);}

    @media(max-width:920px){
      .hero-inner{grid-template-columns:1fr;}
      .picker-grid{grid-template-columns:1fr;}
      .spec-grid{grid-template-columns:repeat(2,1fr);}
      .spec-cell:nth-child(4n){border-right:1px solid var(--page-line);}
      .spec-cell:nth-child(2n){border-right:none;}
      h1.headline{font-size:38px;}
    }
  </style>
</head>
<body>

  <nav class="nav">
    <div class="nav-inner">
      <div class="brand">
        <svg class="brand-mark" viewBox="0 0 22 22" fill="none">
          <rect x="1" y="1" width="9" height="9" rx="2" fill="#4FB8C9"/>
          <rect x="12" y="1" width="9" height="6" rx="2" fill="#F5F4EF" fill-opacity="0.9"/>
          <rect x="12" y="9" width="9" height="12" rx="2" fill="#F5F4EF" fill-opacity="0.5"/>
          <rect x="1" y="12" width="9" height="9" rx="2" fill="#F2A93B"/>
        </svg>
        <span class="brand-name">Keystone Dashboard Layout</span>
      </div>
      <div class="nav-links">
        <div
          class="fw-select">
          <button
            aria-expanded="false"
            aria-haspopup="listbox"
            class="fw-select-trigger nav-link"
            type="button">
            <svg class="fw-select-trigger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/></svg>
            <span>Docs</span>
            <svg class="fw-select-chevron" viewBox="0 0 12 12" fill="none"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <ul
            class="fw-select-menu"
            role="listbox">
            <li>
              <a
                class="fw-select-option is-current"
                href="/vue/"
                role="option">
                <svg viewBox="0 0 24 24" fill="#42B883"><path d="M24,1.61H14.06L12,5.16,9.94,1.61H0L12,22.39ZM12,14.08,5.16,2.23H9.59L12,6.41l2.41-4.18h4.43Z"/></svg>
                <span>Vue</span>
                <span class="fw-select-option-status">LIVE</span>
              </a>
            </li>
            <li>
              <a
                class="fw-select-option"
