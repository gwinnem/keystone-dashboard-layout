  <script>
    // Framework selector dropdowns, attached to both "Docs" and
    // "Examples" — plain vanilla JS, no framework island needed for a
    // simple open/close toggle. Handles every .fw-select on the page
    // independently (not a single hardcoded id), since there are now two
    // (Docs, Examples) and each needs its own open/closed state. Uses a
    // class-based opacity/transform toggle (not the `hidden` attribute)
    // specifically so the CSS transition can actually animate a fade-in
    // — `hidden` applies `display: none` immediately, which a
    // transition can never animate from. Each closes on an outside
    // click or Escape, and opening one closes any other that's already
    // open. The currently selected option (Vue, the only live one right
    // now) is marked is-current in each list so it's visually
    // distinguishable even before React/Angular have their own real
    // docs/examples to switch to.
    const fwSelects = Array.from(document.querySelectorAll('.fw-select'));

    const closeMenu = (fwSelect) => {
      const menu = fwSelect.querySelector('.fw-select-menu');
      const trigger = fwSelect.querySelector('.fw-select-trigger');
      menu.classList.remove('is-visible');
      fwSelect.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    };

    const openMenu = (fwSelect) => {
      fwSelects.forEach((other) => {
        if (other !== fwSelect) closeMenu(other);
      });
      const menu = fwSelect.querySelector('.fw-select-menu');
      const trigger = fwSelect.querySelector('.fw-select-trigger');
      menu.classList.add('is-visible');
      fwSelect.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
    };

    fwSelects.forEach((fwSelect) => {
      const trigger = fwSelect.querySelector('.fw-select-trigger');
      const menu = fwSelect.querySelector('.fw-select-menu');

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        if (menu.classList.contains('is-visible')) {
          closeMenu(fwSelect);
        } else {
          openMenu(fwSelect);
        }
      });
    });

    document.addEventListener('click', (event) => {
      fwSelects.forEach((fwSelect) => {
        if (!fwSelect.contains(event.target)) closeMenu(fwSelect);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        fwSelects.forEach((fwSelect) => closeMenu(fwSelect));
      }
    });

    // Theme toggle (Light / Dark / Auto) for the landing page only —
    // this is a real, working switcher, not just a visual copy of the
    // docs pages' own ThemeSelect. The actual light/dark resolution and
    // flash-of-wrong-theme prevention happens in the tiny inline
    // <script> at the top of <head> (it has to run before paint); this
    // block only handles the widget's own UI and persists changes back
    // to that same localStorage key + <html> attributes so a reload
    // picks up whatever was chosen here.
    const themeSelect = document.getElementById('theme-select');
    if (themeSelect) {
      const labelEl = themeSelect.querySelector('.theme-select-label');
      const optionEls = Array.from(themeSelect.querySelectorAll('.theme-select-option'));
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

      const resolveTheme = (pref) => pref === 'auto'
        ? (mediaQuery.matches ? 'dark' : 'light')
        : pref;

      const applyPreference = (pref) => {
        const resolved = resolveTheme(pref);
        document.documentElement.setAttribute('data-theme', resolved);
        document.documentElement.setAttribute('data-theme-pref', pref);
        themeSelect.setAttribute('data-current-theme', pref);
        // Keeps the docs pages' own Starlight theme in sync with
        // whatever is chosen here — see the <head> script's own comment
        // for why this specific key/value convention matters.
        localStorage.setItem('starlight-theme', pref === 'auto' ? '' : pref);
        if (labelEl) {
          labelEl.textContent = pref.charAt(0).toUpperCase() + pref.slice(1);
        }
        optionEls.forEach((option) => {
          option.classList.toggle('is-current', option.dataset.themeValue === pref);
        });
      };

      // Sync the widget's own UI to whatever the early <head> script
      // already resolved and applied to <html>, rather than assuming
      // 'auto' — the person's actual saved preference may be Light or
      // Dark.
      applyPreference(document.documentElement.getAttribute('data-theme-pref') || 'auto');

      optionEls.forEach((option) => {
        option.addEventListener('click', (event) => {
          event.stopPropagation();
          const pref = option.dataset.themeValue;
          localStorage.setItem('kg-theme', pref);
          applyPreference(pref);
          closeMenu(themeSelect);
        });
      });

      // Only matters while the preference is 'auto' — if the person has
      // explicitly chosen Light or Dark, the system's own scheme
      // changing shouldn't silently override that choice.
      mediaQuery.addEventListener('change', () => {
        if (document.documentElement.getAttribute('data-theme-pref') === 'auto') {
          applyPreference('auto');
        }
      });
    }
  </script>

</body>
</html>
