---
// Overrides Starlight's default Head to add two things every page was
// previously missing entirely: og:image/twitter:image meta tags
// (pointing at the per-page image generated by
// src/pages/og/[...slug].ts, via astro-og-canvas) and JSON-LD
// structured data (TechArticle, BreadcrumbList, and — on the three
// framework home pages specifically — SoftwareSourceCode).
//
// Reads `Astro.props` (entry/siteTitle), NOT `Astro.locals.
// starlightRoute` — grounded in the ACTUAL installed
// @astrojs/starlight@0.30.6 source (read directly from node_modules,
// not assumed): that version's own Head.astro destructures `const {
// entry, lang, siteTitle } = Astro.props;`, the pre-0.32 route-data
// mechanism. The newer `Astro.locals.starlightRoute` API (and the
// `routeMiddleware` config option that would otherwise be the more
// direct way to add this) was introduced in Starlight 0.32 and doesn't
// exist on this installed version — attempting to use it is exactly
// what caused this file to exist as a `Head` override instead of a
// `routeMiddleware` file (confirmed via a real, failed
// `astro build` run: "Unrecognized key(s) in object: 'routeMiddleware'").
// Upgrading Starlight to get that option was deliberately rejected here:
// this project's own other three overrides (Sidebar.astro, Header.astro,
// PageSidebar.astro/TwoColumnContent.astro) all also read `Astro.props`
// for the identical reason, by their own explicit design — upgrading
// past 0.32 would break all of them simultaneously (route data moves to
// `Astro.locals` in that release), a far wider blast radius than
// implementing this one thing against the version actually installed.
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Head.astro';

const { entry, siteTitle } = Astro.props;
const { title, description } = entry.data;
const id = entry.id;

// Astro.site is the `site` option from astro.config.mjs
// (https://kdl.winnem.tech) — required for every URL below to be a
// real, absolute one.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(`/og/${id || 'index'}.png`, Astro.site);

// Breadcrumb trail derived directly from the page's own id (e.g.
// "vue/guide/project/testing" → Vue / Guide / Project / Testing) — a
// real, accurate reflection of this site's own URL structure. Segments
// are title-cased from their raw slug form; this won't always exactly
// match a hand-written sidebar label (e.g. "svg-export-and-payload"
// title-cases awkwardly), a deliberate trade-off for correctness/
// maintainability over per-segment polish.
const segments = id ? id.split('/') : [];
const breadcrumbItems = segments.map((segment, index) => {
  const name = segment
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
  const itemUrl = new URL(`${segments.slice(0, index + 1).join('/')}/`, Astro.site);
  return {
    '@type': 'ListItem',
    position: index + 1,
    name,
    item: itemUrl.href,
  };
});

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    url: pageUrl.href,
    image: ogImageUrl.href,
    isPartOf: {
      '@type': 'WebSite',
      name: siteTitle,
      url: Astro.site?.href,
    },
  },
];

if (breadcrumbItems.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems,
  });
}

// Package metadata for the three framework "home" pages specifically —
// matched defensively against both plausible id shapes (Astro
// content-collection ids sometimes keep a trailing "/index" and
// sometimes don't, depending on the exact collection/glob
// configuration) rather than assuming one and silently missing the
// other.
const frameworkPackages: Record<string, { name: string; description: string }> = {
  vue: {
    name: '@keystone-dashboard-layout/vue',
    description: 'Draggable, resizable dashboard grid layout for Vue 3.',
  },
  react: {
    name: '@keystone-dashboard-layout/react',
    description: 'Draggable, resizable dashboard grid layout for React.',
  },
  angular: {
    name: '@keystone-dashboard-layout/angular',
    description: 'Draggable, resizable dashboard grid layout for Angular.',
  },
};
const frameworkKey = Object.keys(frameworkPackages).find(
  (key) => id === key || id === `${key}/index`,
);
if (frameworkKey) {
  const pkg = frameworkPackages[frameworkKey];
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: pkg.name,
    description: pkg.description,
    programmingLanguage: 'TypeScript',
    codeRepository: 'https://github.com/gwinnem/keystone-dashboard-layout',
    license: 'https://opensource.org/licenses/MIT',
    url: pageUrl.href,
  });
}
---

<Default {...Astro.props}><slot /></Default>
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={ogImageUrl.href} />
{jsonLd.map((item) => (
  <script type="application/ld+json" set:html={JSON.stringify(item)} />
))}
