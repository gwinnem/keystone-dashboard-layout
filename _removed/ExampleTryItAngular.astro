---
// Angular's own counterpart to ExampleTryIt.astro (Vue/React version)
// — embeds one specific example via <iframe>, pointed at a single
// route in the real, deployed angular-examples-app, rather than
// hydrating a live component inline. Deliberate architecture
// difference, not a lesser version of the same thing: Angular examples
// were never embeddable as live Astro islands at all — the
// @analogjs/astro-angular route hit a real, unresolved component-
// resolution bug (see angular-examples-app's own README for the full
// account). A real app iframed from its own subdomain sidesteps that
// entirely, at the cost of running cross-origin rather than inline.
//
// One astro-docs page per example (matching Vue/React's own
// convention) rather than a single whole-app embed — the app's own
// internal sidebar listing all 52 examples was removed for exactly
// this: that navigation now lives in astro-docs' own Starlight sidebar
// instead (astro.config.mjs's own Angular > Examples section), so
// there's no second copy of the same list to keep in sync.
//
// No "Source" tab, unlike the Vue/React version — that would mean
// either duplicating each example's own .ts source into astro-docs
// (matching Vue/React's own convention of copying example source into
// src/components/examples/) or reading it directly from
// ../../../../angular-examples-app/ via a `?raw` import reaching
// outside this project's own root, which Vite's own default
// `server.fs.allow` restricts. Neither is done here yet — the footer
// link below points at the real, canonical source on GitHub instead,
// which is accurate today and doesn't require either workaround.
interface Props {
  /** The route segment under /#/examples/, e.g. "01-basic-drag-resize" — must match a real entry in angular-examples-app's own app.routes.ts. */
  path: string;
  /** Accessible name/title for the iframe, e.g. "Basic drag & resize example". */
  title: string;
  /** iframe height in pixels. Default 560 — a reasonable middle ground now the app's own sidebar is gone (each example's own title/description still render inside the frame, above the grid demo itself); some examples have more vertical content than others and may need their own override. */
  height?: number;
}

const { path, title, height = 560 } = Astro.props as Props;
// import.meta.env.DEV — Vite's own standard flag for "this is a dev
// server run" (astro dev), false for a real `astro build`. Pointing at
// localhost:4200 in dev lets this be checked against a real, locally-
// running instance of angular-examples-app (`ng serve`, its own
// default port) without needing the production deployment to exist
// yet; a real production build always points at the actual deployed
// subdomain.
const base = import.meta.env.DEV ? `http://localhost:4200` : `https://kdla.winnem.tech`;
const iframeSrc = `${base}/#/examples/${path}`;
const sourceUrl = `https://github.com/gwinnem/keystone-dashboard-layout/blob/main/angular-examples-app/src/app/pages/${path}.page.component.ts`;
---

<div class="try-it-ng not-content">
  <div class="try-it-ng__card">
    <div class="try-it-ng__toolbar">
      <span class="try-it-ng__label">{path}.page.component.ts</span>
      <a
        class="try-it-ng__source-link"
        href={sourceUrl}
        rel="noopener"
        target="_blank">
        View source on GitHub
        <svg fill="none" viewBox="0 0 12 12"><path d="M3 9l6-6M4 3h5v5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3"/></svg>
      </a>
    </div>
    <div class="try-it-ng__stage">
      <iframe
        height={height}
        loading="lazy"
        src={iframeSrc}
        title={title}
        width="100%"></iframe>
    </div>
    <div class="try-it-ng__footer">
      <svg
        class="try-it-ng__footer-icon"
        fill="none"
        viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="6.5" stroke="currentColor" />
        <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>Live demo, hosted separately at <a href={base} rel="noopener" target="_blank">{base.replace(`https://`, ``).replace(`http://`, ``)}</a></span>
    </div>
  </div>
</div>

<style>
  .try-it-ng {
    margin: 24px 0;
  }

  .try-it-ng__card {
    background: var(--kg-paper-2);
    border: 1px solid var(--kg-line-light);
    border-radius: 12px;
    overflow: hidden;
  }

  .try-it-ng__toolbar {
    align-items: center;
    background: var(--kg-paper-3);
    border-bottom: 1px solid var(--kg-line-light);
    display: flex;
    justify-content: space-between;
    padding: 10px 16px;
  }

  .try-it-ng__label {
    color: var(--kg-blueprint-deep);
    font-family: var(--kg-font-mono);
    font-size: 13px;
  }

  .try-it-ng__source-link {
    align-items: center;
    color: var(--kg-text-lo-light);
    display: flex;
    font-family: var(--kg-font-body);
    font-size: 12.5px;
    font-weight: 500;
    gap: 5px;
    text-decoration: none;
  }

  .try-it-ng__source-link:hover {
    color: var(--kg-text-hi-light);
  }

  .try-it-ng__source-link svg {
    flex-shrink: 0;
    height: 11px;
    width: 11px;
  }

  .try-it-ng__stage {
    padding: 20px;
  }

  .try-it-ng__stage iframe {
    border: 1px solid var(--kg-line-light);
    border-radius: 8px;
    display: block;
  }

  .try-it-ng__footer {
    align-items: center;
    background: var(--kg-paper-2);
    border-top: 1px solid var(--kg-line-light);
    color: var(--kg-text-lo-light);
    display: flex;
    font-size: 13px;
    gap: 8px;
    padding: 12px 16px;
  }

  .try-it-ng__footer a {
    color: var(--kg-blueprint-deep);
    text-decoration: underline;
  }

  .try-it-ng__footer-icon {
    flex-shrink: 0;
    height: 14px;
    width: 14px;
  }
</style>
