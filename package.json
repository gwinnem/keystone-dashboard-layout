{
  "name": "keystone-dashboard-layout",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-framework (Vue/React/Angular) responsive dashboard grid layout monorepo.",
  "license": "MIT",
  "author": "Geirr Winnem <geirr@winnem.tech>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwinnem/keystone-dashboard-layout.git"
  },
  "bugs": {
    "url": "https://github.com/gwinnem/keystone-dashboard-layout/issues"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:style": "turbo run lint:style",
    "typecheck": "turbo run typecheck",
    "check:licenses": "license-checker-rseidelsohn --production --onlyAllow \"MIT;BSD-2-Clause;BSD-3-Clause;ISC;Apache-2.0;0BSD;CC0-1.0;Unlicense\" --summary",
    "format": "prettier --write \"packages/**/src/**/*\"",
    "docs:dev": "vitepress dev vitepress-docs",
    "docs:build": "vitepress build vitepress-docs",
    "docs:preview": "vitepress preview vitepress-docs",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "commit": "cz",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "conventional-changelog-angular": "^9.2.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.7.0",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^17.7.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.5.3",
    "semantic-release": "^25.0.8",
    "turbo": "^2.3.0",
    "typescript": "^6.0.3",
    "vitepress": "1.6.3"
  },
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || >=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.15.3",
      "esbuild": "0.25.12",
      "@commitlint/load": "20.5.3",
      "@commitlint/types": "20.5.0",
      "@commitlint/execute-rule": "20.0.0",
      "@commitlint/resolve-extends": "20.5.3",
      "@commitlint/config-validator": "20.5.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "vue-demi"
    ]
  }
}
